<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="pulse/pulse-common" value="[IHRE_PULSE_URL]" />
  </packageSources>

  <packageSourceMapping>
    <!-- Alle Pakete von nuget.org, außer explizit anders definiert -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>

    <!-- Pulse packages from pulse/pulse-common -->
    <packageSource key="pulse/pulse-common">
      <package pattern="Pulse.*" />
      <package pattern="PulseCore.*" />
      <package pattern="AiBotFramework.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
