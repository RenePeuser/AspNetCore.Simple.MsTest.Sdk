<Project>
    <PropertyGroup>
        <!-- TargetFramework: Specifies the .NET target framework for all projects.
            'net9.0' targets .NET 9.0, ensuring all projects use the same runtime and API surface.-->
        <TargetFramework>net9.0</TargetFramework>

        <!-- LangVersion: Sets the C# language version to the latest major version available.
             This allows usage of the newest C# language features. -->
        <LangVersion>latestmajor</LangVersion>

        <!-- AnalysisLevel: Uses the latest available analyzer rules and improvements. -->
        <AnalysisLevel>latest</AnalysisLevel>

        <!-- Nullable: Enables nullable reference types to help avoid null reference errors. -->
        <Nullable>enable</Nullable>

        <!-- WarningsAsErrors:Nullable: Treats all nullable reference type warnings as errors
             This enforces strict null-safety in code. -->
        <WarningsAsErrors>Nullable</WarningsAsErrors>

        <!-- EnforceCodeStyleInBuild: Enforces code style rules during the build process.
             Code style violations will cause build warnings or errors. -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!-- TreatWarningsAsErrors: Treats all build warnings as errors.
             This ensures the codebase remains warning-free. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!-- AccelerateBuildsInVisualStudio: Optimizes build performance in Visual Studio. -->
        <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>

        <!-- GenerateDocumentationFile: Generates XML documentation files for the code.
             Useful for API documentation and IntelliSense. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- ImplicitUsings: Enables implicit global using directives for common namespaces.
             Reduces the need for repetitive using statements in each file. -->
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- InvariantGlobalization: Uses invariant globalization mode for consistent culture behavior.
             Useful for deterministic builds and environments where globalization is not required. -->
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- Deterministic: Ensures builds are deterministic, producing identical binaries for identical inputs. -->
        <Deterministic>true</Deterministic>

        <!-- EnableNETAnalyzers: (duplicate, but ensures analyzers are enabled) -->
        <EnableNETAnalyzers>true</EnableNETAnalyzers>

        <!-- AnalysisMode: Enables all analyzer rules by default for maximum code quality enforcement. -->
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    </PropertyGroup>
</Project>
