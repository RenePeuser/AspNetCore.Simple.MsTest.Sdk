<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageLicenseFile>License.txt</PackageLicenseFile>
        <Authors>Rene Peuser</Authors>
        <Company>Rene Peuser Softwaresolutions</Company>
        <Description>A simple sdk to write easy and fast tests for your web api's</Description>
        <Copyright>Copyright 2021 (c) Rene Peuser. All rights reserved.</Copyright>
        <PackageProjectUrl>https://github.com/RenePeuser/AspNetCore.Simple.MsTest.Sdk</PackageProjectUrl>
        <RepositoryUrl>https://github.com/RenePeuser/AspNetCore.Simple.MsTest.Sdk</RepositoryUrl>
        <PackageTags>aspnetcore;testing;snapshot-testing;snapshot;mstest;api-testing;integration-testing;http-testing;test-framework;regression-testing;web-api;rest-api;test-automation;test-sdk;aspnetcore-testing;api-snapshots;http-assertions;minimal-api;webapi-testing;contract-testing;response-validation;csharp;dotnet;json;json-comparison;diff;approval-testing;unit-testing;curl;http-client;testhost;</PackageTags>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
        <PackageId>AspNetCore.Simple.MsTest.Sdk</PackageId>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <NoWarn>CA1515;CA1707;CA1054;CA1062;MSTEST0016;CA2234;IDE0032;IDE0053;IDE0060;IDE0038;IDE0059;IDE0052</NoWarn>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <!--Property group settings for source link !-->
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\License.txt">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\..\readme.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Asp.Versioning.Abstractions" />
        <PackageReference Include="Asp.Versioning.Http" />
        <PackageReference Include="Asp.Versioning.Mvc" />
        <PackageReference Include="Extensions.Pack" />
        <PackageReference Include="GitVersion.MsBuild">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
        <PackageReference Include="MSTest.TestFramework" />
        <PackageReference Include="System.CodeDom" />
    </ItemGroup>
    <ItemGroup>
        <Folder Include="ErrorHandling\" />
        <Folder Include="FluentAssertions\" />
        <Folder Include="AssertExtensions\" />
    </ItemGroup>

    <!-- Ship the fluent-API analyzer (MSTESTSDK001) and its code fix as analyzer assets inside the
         NuGet package, so consumers automatically get the dangling-chain diagnostic AND the one-click fix.
         The ProjectReferences (OutputItemType=Analyzer) apply both to THIS project at dev time and
         build them before packaging; the <None Pack=true> entries are what actually put the DLLs into
         the package. Both must sit under analyzers/dotnet/cs for Roslyn/VS to load them. -->
    <ItemGroup>
        <ProjectReference Include="..\AspNetCore.Simple.MsTest.Sdk.Analyzers\AspNetCore.Simple.MsTest.Sdk.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\AspNetCore.Simple.MsTest.Sdk.CodeFixes\AspNetCore.Simple.MsTest.Sdk.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\AspNetCore.Simple.MsTest.Sdk.Analyzers\bin\$(Configuration)\netstandard2.0\AspNetCore.Simple.MsTest.Sdk.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="..\AspNetCore.Simple.MsTest.Sdk.CodeFixes\bin\$(Configuration)\netstandard2.0\AspNetCore.Simple.MsTest.Sdk.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <!-- MEF composition dependencies must ship beside the code-fix assembly; Roslyn does not read
             the code-fix project's .deps.json when loading analyzer assets from a package. -->
        <None Include="..\AspNetCore.Simple.MsTest.Sdk.CodeFixes\bin\$(Configuration)\netstandard2.0\System.Composition*.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

    <!-- The NuGet "Release Notes" tab shows the topmost "## " section of RELEASE-NOTES.md (the current
         release): everything from the first "## " heading up to the next one. nuget.org renders it as
         plain text, so the markdown appears as written. -->
    <PropertyGroup>
        <ReleaseNotesFile>$(MSBuildThisFileDirectory)..\..\RELEASE-NOTES.md</ReleaseNotesFile>
    </PropertyGroup>

    <Target Name="LoadPackageReleaseNotes" BeforeTargets="GenerateNuspec">
        <Error Condition="!Exists('$(ReleaseNotesFile)')" Text="Release notes file not found: $(ReleaseNotesFile)" />
        <PropertyGroup>
            <PackageReleaseNotes>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(ReleaseNotesFile)')), '(?ms)^## .*?(?=^## |\z)').Value.Trim())</PackageReleaseNotes>
        </PropertyGroup>
        <Error Condition="'$(PackageReleaseNotes)' == ''" Text="No '## ' section found in $(ReleaseNotesFile)." />
    </Target>

</Project>
