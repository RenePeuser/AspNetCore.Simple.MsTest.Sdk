<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageLicenseFile>License.txt</PackageLicenseFile>
        <Authors>Rene Peuser</Authors>
        <Company>Rene Peuser Softwaresolutions</Company>
        <Descriptiotn>A simple sdk to write easy and fast tests for your web api's</Descriptiotn>
        <Copyright>Copyright 2021 (c) Rene Peuser. All rights reserved.</Copyright>
        <PackageProjectUrl>https://renepeuser.visualstudio.com/_git/AspNetCore.Simple.MsTest.Sdk</PackageProjectUrl>
        <RepositoryUrl>https://renepeuser.visualstudio.com/_git/AspNetCore.Simple.MsTest.Sdk</RepositoryUrl>
        <PackageTags>aspnetcore;testing;snapshot-testing;snapshot;mstest;api-testing;integration-testing;http-testing;test-framework;regression-testing;web-api;rest-api;test-automation;test-sdk;aspnetcore-testing;api-snapshots;http-assertions;minimal-api;webapi-testing;contract-testing;response-validation;csharp;dotnet;json;json-comparison;diff;approval-testing;unit-testing;curl;http-client;testhost;</PackageTags>
        <PackageReleaseNotes>
            NEW FEATURES:
            - Expected Status Code validation: All Assert methods now support optional expectedStatusCode parameter
            Example: Client.AssertPostAsync&lt;T&gt;("api/endpoint", "Request.json", "Response.json", expectedStatusCode: HttpStatusCode.Created)
            Allows explicit status code validation (200, 201, etc.) instead of just 2xx success range
            Bugfixes with order and filter func
        </PackageReleaseNotes>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
        <PackageId>AspNetCore.Simple.MsTest.Sdk</PackageId>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <NoWarn>CA1515;CA1707;CA1054;CA1062;MSTEST0016;CA2234;IDE0032;IDE0053;IDE0060;IDE0038;IDE0059;IDE0052</NoWarn>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <!--Property group settings for source link !-->
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\License.txt">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\..\readme.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Asp.Versioning.Abstractions" />
        <PackageReference Include="Asp.Versioning.Http" />
        <PackageReference Include="Asp.Versioning.Mvc" />
        <PackageReference Include="Extensions.Pack" />
        <PackageReference Include="GitVersion.MsBuild">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.SourceLink.AzureRepos.Git" PrivateAssets="All" />
        <PackageReference Include="MSTest.TestFramework" />
        <PackageReference Include="System.CodeDom" />
    </ItemGroup>
    <ItemGroup>
        <Folder Include="ErrorHandling\" />
        <Folder Include="FluentAssertions\" />
        <Folder Include="AssertExtensions\" />
    </ItemGroup>

    <!-- ALPHA-ONLY fluent API (strategy: release the fluent API in alpha/prerelease only, until its
         final shape is decided — see FluentAssertions/README.md). The FLUENT_ALPHA symbol flips the
         entry points from internal to public. It is defined when:
           * the build produces a prerelease version, e.g. /develop → "…-alpha.N"
             (GitVersion_PreReleaseTag is non-empty), OR
           * FluentAlpha=true is passed explicitly (dotnet build -p:FluentAlpha=true / local dev).
         In-repo test projects reach the API via the public contract only, enforcing real-world usage.

         IMPORTANT — timing: GitVersion.MsBuild sets GitVersion_* in a TARGET (GetVersion), not at
         project-evaluation time. A plain <PropertyGroup Condition="…GitVersion_…"> would evaluate too
         early and never see the value. So the constant is appended in a target that runs AFTER
         GetVersion and BEFORE CoreCompile. -->
    <PropertyGroup Condition="'$(FluentAlpha)' == 'true'">
        <DefineConstants>$(DefineConstants);FLUENT_ALPHA</DefineConstants>
    </PropertyGroup>

    <Target Name="DefineFluentAlphaForPrerelease" AfterTargets="GetVersion" BeforeTargets="CoreCompile" Condition="'$(GitVersion_PreReleaseTag)' != '' and '$(FluentAlpha)' != 'true'">
        <PropertyGroup>
            <DefineConstants>$(DefineConstants);FLUENT_ALPHA</DefineConstants>
        </PropertyGroup>
        <Message Importance="high" Text="FLUENT_ALPHA enabled — prerelease build '$(GitVersion_NuGetVersion)' (fluent API is public)." />
    </Target>

    <!-- Ship the fluent-API analyzer (MSTESTSDK001) and its code fix as analyzer assets inside the
         NuGet package, so consumers automatically get the dangling-chain diagnostic AND the one-click fix.
         The ProjectReferences (OutputItemType=Analyzer) apply both to THIS project at dev time and
         build them before packaging; the <None Pack=true> entries are what actually put the DLLs into
         the package. Both must sit under analyzers/dotnet/cs for Roslyn/VS to load them. -->
    <ItemGroup>
        <ProjectReference Include="..\AspNetCore.Simple.MsTest.Sdk.Analyzers\AspNetCore.Simple.MsTest.Sdk.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\AspNetCore.Simple.MsTest.Sdk.CodeFixes\AspNetCore.Simple.MsTest.Sdk.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\AspNetCore.Simple.MsTest.Sdk.Analyzers\bin\$(Configuration)\netstandard2.0\AspNetCore.Simple.MsTest.Sdk.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="..\AspNetCore.Simple.MsTest.Sdk.CodeFixes\bin\$(Configuration)\netstandard2.0\AspNetCore.Simple.MsTest.Sdk.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <!-- MEF composition dependencies must ship beside the code-fix assembly; Roslyn does not read
             the code-fix project's .deps.json when loading analyzer assets from a package. -->
        <None Include="..\AspNetCore.Simple.MsTest.Sdk.CodeFixes\bin\$(Configuration)\netstandard2.0\System.Composition*.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

</Project>
