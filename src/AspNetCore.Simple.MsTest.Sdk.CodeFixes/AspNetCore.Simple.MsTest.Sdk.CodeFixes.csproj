<Project Sdk="Microsoft.NET.Sdk">

    <!-- Roslyn code-fix providers MUST target netstandard2.0 to load into the compiler/IDE host. -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <TargetFrameworks></TargetFrameworks>
        <IsPackable>false</IsPackable>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <!-- RS2008: release-tracking file not needed for this internal, under-construction component.
             CA1062: the Roslyn host never passes a null context to the provider. -->
        <NoWarn>$(NoWarn);RS2008;CA1062</NoWarn>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Workspaces.Common brings Document/SyntaxGenerator/CodeAction — needed by code fixes but
             NOT by analyzers. The host (VS/Rider) provides this assembly at runtime, so it is a
             compile-time reference only and is NOT packed into the NuGet package. -->
        <!-- Pin to Roslyn 4.8.0 (VS 2022 17.8+ / Rider 2023.3+), NOT the solution-wide 5.6.0 — same reason
             as the analyzer project: a code fix built against 5.6.0 never loads in an older IDE host, so the
             lightbulb quick-fix never appears even though the CLI build reports MSTESTSDK001. Workspaces.Common
             pins in lockstep with the analyzer's CodeAnalysis.CSharp version. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="4.8.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <!-- The code fix reports against MSTESTSDK001, owned by the analyzer project. -->
        <ProjectReference Include="..\AspNetCore.Simple.MsTest.Sdk.Analyzers\AspNetCore.Simple.MsTest.Sdk.Analyzers.csproj" />
    </ItemGroup>

</Project>
