<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <NoWarn>CA1515;CA1707;CA1054;CA1062;MSTEST0016;IDE0053;CA1861</NoWarn>
    </PropertyGroup>

    <!--Embedded files area-->
    <ItemGroup>
        <EmbeddedResource Include="**\*.txt" Exclude="bin\**\*;obj\**\*"/>
        <EmbeddedResource Include="**\*.json" Exclude="bin\**\*;obj\**\*;appsettings*.json;Legacy\**\*"/>

        <!-- Regression fixture for legacy projects whose RootNamespace differs from the AssemblyName.
             LogicalName pins a resource name that does NOT start with "Controllers.Test.", so the
             resource name cannot be mapped to its file on disk by stripping the assembly name.
             See IResourceRootNamespaceResolver / LegacyRootNamespaceTests. -->
        <EmbeddedResource Include="Legacy\V1\Results\LegacyRootNamespace.json"
                          LogicalName="Pulse.Legacy.Root.Legacy.V1.Results.LegacyRootNamespace.json"/>
        <EmbeddedResource Include="**\*.sh" Exclude="bin\**\*;obj\**\*"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing"/>
        <PackageReference Include="MSTest"/>
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AspNetCore.Simple.MsTest.Sdk\AspNetCore.Simple.MsTest.Sdk.csproj"/>
        <ProjectReference Include="..\Controllers\Controllers.csproj"/>
        <ProjectReference Include="..\AspNetCore.Simple.MsTest.Sdk.Analyzers\AspNetCore.Simple.MsTest.Sdk.Analyzers.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <!-- CodeFixes as an Analyzer asset too, so the MSTESTSDK001 lightbulb quick-fix ("await …ExecuteAsync()")
             shows up live in VS/Rider within THIS solution — not just the red squiggle. The analyzer alone
             produces the diagnostic; without this reference there is no fix to offer. -->
        <ProjectReference Include="..\AspNetCore.Simple.MsTest.Sdk.CodeFixes\AspNetCore.Simple.MsTest.Sdk.CodeFixes.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup Condition="Exists('..\AspNetCore.Simple.MsTest.Sdk.Analyzers\bin\$(Configuration)\netstandard2.0\AspNetCore.Simple.MsTest.Sdk.Analyzers.dll') and Exists('..\AspNetCore.Simple.MsTest.Sdk.CodeFixes\bin\$(Configuration)\netstandard2.0\AspNetCore.Simple.MsTest.Sdk.CodeFixes.dll')">
        <Analyzer Include="..\AspNetCore.Simple.MsTest.Sdk.Analyzers\bin\$(Configuration)\netstandard2.0\AspNetCore.Simple.MsTest.Sdk.Analyzers.dll"/>
        <Analyzer Include="..\AspNetCore.Simple.MsTest.Sdk.CodeFixes\bin\$(Configuration)\netstandard2.0\AspNetCore.Simple.MsTest.Sdk.CodeFixes.dll"/>
        <Analyzer Include="..\AspNetCore.Simple.MsTest.Sdk.CodeFixes\bin\$(Configuration)\netstandard2.0\System.Composition*.dll"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.test.json">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
