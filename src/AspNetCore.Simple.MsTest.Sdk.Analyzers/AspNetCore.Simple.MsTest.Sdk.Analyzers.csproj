<Project Sdk="Microsoft.NET.Sdk">

    <!-- Roslyn analyzers MUST target netstandard2.0 to load into the compiler. -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <TargetFrameworks></TargetFrameworks>
        <IsPackable>false</IsPackable>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <!-- RS2008: release-tracking file not needed for this internal, under-construction analyzer.
             CA1062: the Roslyn host never passes a null context to Initialize. -->
        <NoWarn>$(NoWarn);RS2008;CA1062</NoWarn>
        <!-- netstandard2.0 lacks some APIs the global AllEnabledByDefault analysis flags; keep it lean. -->
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Pin to Roslyn 4.8.0 (VS 2022 17.8+ / Rider 2023.3+), NOT the solution-wide 5.6.0. An analyzer
             loads ONLY into a host whose Roslyn version is >= the one it was compiled against. Building
             against 5.6.0 makes the CLI (SDK 10) report the diagnostic but silently fails to load in every
             IDE with an older language service — no squiggles, no code fix. 4.8.0 is the lowest baseline
             that still has every API used here, so the diagnostic + fix light up in-editor for consumers. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.8.0" PrivateAssets="all"/>
    </ItemGroup>

</Project>
