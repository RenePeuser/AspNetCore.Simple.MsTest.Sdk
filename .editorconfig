# To learn more about .editorconfig see https://aka.ms/editorconfigdocs
# Marks this EditorConfig file as the root; parent directories will not be searched.
root = true

###############################
# Core EditorConfig Options   #
###############################
# Section that applies to all files of any type.
[*]
# Use Windows-style line endings (CRLF).
end_of_line = crlf
# Use spaces instead of tab characters for indentation.
indent_style = space
# Visual width of a tab character in editors (does not affect indentation since spaces are used).
tab_width = 4

# Apply the following rules to C# and VB code files.
[*.{cs,csx,vb,vbx}]
# Use UTF-8 with BOM encoding for code files.
charset = utf-8-bom
# Indentation size is 4 spaces.
indent_size = 4
# Ensure files end with a final newline on save.
insert_final_newline = true

###############################
# .NET Coding Conventions     #
###############################
# Apply the following .NET code-style rules to C# and VB files.
[*.{cs,vb}]
# Place System.* using directives before other usings.
dotnet_sort_system_directives_first = true

# Prefer language keywords (e.g., int) over BCL types (e.g., Int32) in declarations.
dotnet_style_predefined_type_for_locals_parameters_members = true:silent
# Prefer language keywords over BCL types for member access (e.g., int.MaxValue).
dotnet_style_predefined_type_for_member_access = true:silent

# Do not require 'this.' qualification for events.
dotnet_style_qualification_for_event = false:silent
# Do not require 'this.' qualification for fields.
dotnet_style_qualification_for_field = false:silent
# Do not require 'this.' qualification for methods.
dotnet_style_qualification_for_method = false:silent
# Do not require 'this.' qualification for properties.
dotnet_style_qualification_for_property = false:silent

# Prefer using the null-coalescing operator where applicable.
dotnet_style_coalesce_expression = true:suggestion
# Prefer collection initializers when creating collections.
dotnet_style_collection_initializer = true:suggestion
# Prefer explicit tuple element names to be used when available.
dotnet_style_explicit_tuple_names = true:suggestion
# Prefer null-propagation (?. and ?[]) to explicit null checks.
dotnet_style_null_propagation = true:suggestion
# Prefer object initializers when setting properties at creation time.
dotnet_style_object_initializer = true:suggestion
# Prefer auto-implemented properties where possible.
dotnet_style_prefer_auto_properties = true:silent
# Prefer conditional expressions over assignments in conditionals.
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
# Prefer conditional expressions over early returns where applicable.
dotnet_style_prefer_conditional_expression_over_return = true:silent
# Prefer inferred member names in anonymous types.
dotnet_style_prefer_inferred_anonymous_type_member_names = true:suggestion
# Prefer inferred tuple element names when possible.
dotnet_style_prefer_inferred_tuple_names = true:suggestion
# Prefer 'is null' pattern over ReferenceEquals for null checks.
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:silent
# Prefer fields that can be readonly to be marked readonly.
dotnet_style_readonly_field = true:suggestion
# Prefer simplified boolean expressions where applicable.
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
# When wrapping binary operators, put the operator at the beginning of the new line.
dotnet_style_operator_placement_when_wrapping = beginning_of_line

###############################
# Naming Conventions          #
###############################
# Define a naming style that uses PascalCase capitalization.
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Enforce PascalCase for constant fields.
dotnet_naming_rule.constant_fields_should_be_pascal_case.severity = suggestion
# Apply the PascalCase style to the rule for constant fields.
dotnet_naming_rule.constant_fields_should_be_pascal_case.style = pascal_case_style
# Target the rule to the 'constant_fields' symbol group.
dotnet_naming_rule.constant_fields_should_be_pascal_case.symbols = constant_fields
# Define symbol group: all accessibility levels.
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
# Define symbol group: only fields.
dotnet_naming_symbols.constant_fields.applicable_kinds = field
# Define symbol group: must be const fields.
dotnet_naming_symbols.constant_fields.required_modifiers = const

###############################
# Analyzer severities (general)
###############################
# Default severity for analyzer diagnostics is warning (unless overridden below).
[*.{cs,vb}]
# Global default analyzer severity is warning.
dotnet_analyzer_diagnostic.severity = warning
# CA1305: Specify IFormatProvider (suggest: not enforced).
dotnet_diagnostic.CA1305.severity = suggestion
# CA1859: Use concrete types when possible for improved performance.
dotnet_diagnostic.CA1848.severity = suggestion
# CA1859: Use constant instead of field where possible.
dotnet_diagnostic.CA1859.severity = error
# CA1860: Prefer 'string.Create' for string concatenation in loops.
dotnet_diagnostic.CA1860.severity = suggestion
# CA1861: Avoid using 'Enumerable.Any' with Count > 0 checks.
dotnet_diagnostic.CA1861.severity = suggestion
# CA2254: Template should be a static expression in logging.
dotnet_diagnostic.CA2254.severity = suggestion
# MSTEST0015: Test method names should follow guidelines (suggest).
dotnet_diagnostic.MSTEST0015.severity = suggestion
# MSTEST0016: Avoid 'ExpectedException' attribute (suggest).
dotnet_diagnostic.MSTEST0016.severity = suggestion

###############################
# C# Coding Conventions       #
###############################
# Apply the following C#-specific code-style rules.
[*.cs]
# Prefer 'var' in places where the type is not apparent (general preference).
csharp_style_var_elsewhere = true:error
# Prefer 'var' for built-in types (e.g., int, string).
csharp_style_var_for_built_in_types = true:error
# Prefer 'var' when the type is apparent from the right-hand side.
csharp_style_var_when_type_is_apparent = true:error

# Prefer expression-bodied accessors (get/set) when possible.
csharp_style_expression_bodied_accessors = true:silent
# Do not prefer expression-bodied constructors.
csharp_style_expression_bodied_constructors = false:silent
# Prefer expression-bodied indexers when possible.
csharp_style_expression_bodied_indexers = true:silent
# Prefer expression-bodied lambdas.
csharp_style_expression_bodied_lambdas = true:silent
# Do not prefer expression-bodied local functions.
csharp_style_expression_bodied_local_functions = false:silent
# Do not prefer expression-bodied methods.
csharp_style_expression_bodied_methods = false:silent
# Do not prefer expression-bodied operators.
csharp_style_expression_bodied_operators = false:silent
# Prefer expression-bodied properties when possible.
csharp_style_expression_bodied_properties = true:silent

# Prefer local functions instead of anonymous functions where pattern matching is used.
csharp_style_pattern_local_over_anonymous_function = true:suggestion
# Prefer pattern matching over 'as' with a null check.
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
# Prefer pattern matching over 'is' followed by a cast.
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion

# Prefer conditional delegate invocation using ?. operator.
csharp_style_conditional_delegate_call = true:suggestion
# Prefer using throw expressions (e.g., => throw ...) where appropriate.
csharp_style_throw_expression = true:suggestion

# Preferred order of modifiers in declarations.
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:suggestion

# Always use braces for control blocks.
csharp_prefer_braces = true:silent
# Prefer 'default' literal over 'default(T)' when type is clear.
csharp_prefer_simple_default_expression = true:suggestion
# Allow embedded statements on the same line (style preference).
csharp_style_allow_embedded_statements_on_same_line_experimental = true:silent
# Prefer deconstruction syntax when possible.
csharp_style_deconstructed_variable_declaration = true:suggestion
# Prefer inline variable declarations in out parameters.
csharp_style_inlined_variable_declaration = true:suggestion
# Use block-scoped namespace declarations (not file-scoped).
csharp_style_namespace_declarations = block_scoped:silent
# Prefer method group conversion over lambda when possible.
csharp_style_prefer_method_group_conversion = true:silent
# Prefer primary constructors where supported.
csharp_style_prefer_primary_constructors = true:suggestion
# Prefer simple property accessors formatting.
csharp_style_prefer_simple_property_accessors = true:suggestion
# Prefer top-level statements in programs where applicable.
csharp_style_prefer_top_level_statements = true:silent
# Discard results of expressions by assigning to underscore (_) rather than ignoring.
csharp_style_unused_value_expression_statement_preference = discard_variable:silent
# Prefer simple using statements (without braces) when possible.
csharp_prefer_simple_using_statement = true:suggestion
# Prefer lock statements over Monitor.Enter/Exit.
csharp_prefer_system_threading_lock = true:suggestion

###############################
# C# Formatting Rules         #
###############################
# Apply the following whitespace and formatting rules for C#.
[*.cs]
# Place 'catch' on a new line.
csharp_new_line_before_catch = true
# Place 'else' on a new line.
csharp_new_line_before_else = true
# Place 'finally' on a new line.
csharp_new_line_before_finally = true
# Place each member in anonymous types on a new line.
csharp_new_line_before_members_in_anonymous_types = true
# Place each member in object initializers on a new line.
csharp_new_line_before_members_in_object_initializers = true
# Place an open brace on a new line for all constructs.
csharp_new_line_before_open_brace = all
# Insert a new line between clauses in query expressions.
csharp_new_line_between_query_expression_clauses = true

# Indent contents within case blocks.
csharp_indent_case_contents = true
# Place labels at the leftmost column (no indentation).
csharp_indent_labels = flush_left
# Indent switch labels relative to switch.
csharp_indent_switch_labels = true

# Do not add a space after a cast.
csharp_space_after_cast = false
# Add a space after keywords in control-flow statements (if, for, while, etc.).
csharp_space_after_keywords_in_control_flow_statements = true
# Add a space after the colon in base/interface lists.
csharp_space_after_colon_in_inheritance_clause = true
# Add spaces around binary operators.
csharp_space_around_binary_operators = before_and_after
# Add a space before the colon in base/interface lists.
csharp_space_before_colon_in_inheritance_clause = true
# No space between method call parentheses when empty.
csharp_space_between_method_call_empty_parameter_list_parentheses = false
# No space between method name and opening parenthesis on calls.
csharp_space_between_method_call_name_and_opening_parenthesis = false
# No space inside method call parentheses.
csharp_space_between_method_call_parameter_list_parentheses = false
# No space between method declaration parentheses when empty.
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
# No space inside method declaration parentheses.
csharp_space_between_method_declaration_parameter_list_parentheses = false
# No spaces inside parentheses in general.
csharp_space_between_parentheses = false

# Preserve single-line blocks.
csharp_preserve_single_line_blocks = true
# Preserve single-line statements.
csharp_preserve_single_line_statements = true
# Place using directives outside the namespace declaration.
csharp_using_directive_placement = outside_namespace:silent

###############################
# C# Analyzer severities      #
###############################
# Override specific C# analyzer severities.
[*.cs]
# CA1032: Implement standard exception constructors (do not enforce).
dotnet_diagnostic.CA1032.severity = silent
# CA1701: Identifiers should have correct suffix (do not enforce).
dotnet_diagnostic.CA1701.severity = silent
# CA1702: Compound words should be cased correctly (do not enforce).
dotnet_diagnostic.CA1702.severity = silent
# CA1707: Identifiers should not contain underscores (do not enforce).
dotnet_diagnostic.CA1707.severity = silent
# CA1711: Identifiers should not have incorrect suffix (do not enforce).
dotnet_diagnostic.CA1711.severity = silent
# CA1716: Identifiers should not match keywords (do not enforce).
dotnet_diagnostic.CA1716.severity = silent
# CA1724: Type names should not conflict with namespaces (do not enforce).
dotnet_diagnostic.CA1724.severity = silent
# CA1812: Avoid uninstantiated internal classes (disabled).
dotnet_diagnostic.CA1812.severity = none
# CA1819: Properties should not return arrays (do not enforce).
dotnet_diagnostic.CA1819.severity = silent
# CA1822: Mark members as static (do not enforce).
dotnet_diagnostic.CA1822.severity = silent
# CA2007: Do not directly await a Task without ConfigureAwait (warning).
dotnet_diagnostic.CA2007.severity = warning
# CS1591: Missing XML comment for publicly visible type or member (disabled).
dotnet_diagnostic.CS1591.severity = none
# CS1998: Async method lacks 'await' operators (error).
dotnet_diagnostic.CS1998.severity = error
# CS9107: Member may be static (do not enforce).
dotnet_diagnostic.CS9107.severity = silent
# IDE0003: Remove qualification (do not enforce).
dotnet_diagnostic.IDE0003.severity = silent
# IDE0005: Remove unnecessary usings (do not enforce).
dotnet_diagnostic.IDE0005.severity = silent
# IDE0008: Use explicit type (do not enforce).
dotnet_diagnostic.IDE0008.severity = silent
# IDE0010: Add missing cases to switch (do not enforce).
dotnet_diagnostic.IDE0010.severity = silent
# IDE0011: Add missing braces to switch (do not enforce).
dotnet_diagnostic.IDE0011.severity = error
# IDE0017: Object initialization simplification (do not enforce).
dotnet_diagnostic.IDE0017.severity = silent
# IDE0022: Use block body for methods (disabled).
dotnet_diagnostic.IDE0022.severity = none
# IDE0028: Collection initialization simplification (disabled).
dotnet_diagnostic.IDE0028.severity = none
# IDE0037: Use inferred member name (suggest).
dotnet_diagnostic.IDE0037.severity = suggestion
# IDE0042: Deconstruct variable declaration (suggest).
dotnet_diagnostic.IDE0042.severity = suggestion
# IDE0045: Convert to conditional expression (suggest).
dotnet_diagnostic.IDE0045.severity = suggestion
# IDE0046: Convert to conditional expression (single-line) (do not enforce).
dotnet_diagnostic.IDE0046.severity = silent
# IDE0050: Convert to tuple (do not enforce).
dotnet_diagnostic.IDE0050.severity = silent
# IDE0055: Fix formatting (suggest).
dotnet_diagnostic.IDE0055.severity = suggestion
# IDE0057: Use range operator (do not enforce).
dotnet_diagnostic.IDE0057.severity = silent
# IDE0058: Expression value is never used (do not enforce).
dotnet_diagnostic.IDE0058.severity = silent
# IDE0066: Convert switch statement to expression (do not enforce).
dotnet_diagnostic.IDE0066.severity = silent
# IDE0072: Add missing switch cases (do not enforce).
dotnet_diagnostic.IDE0072.severity = silent
# IDE0090: Use 'new(...)' expressions (suggest).
dotnet_diagnostic.IDE0090.severity = suggestion
# IDE0130: Namespace should match folder structure (do not enforce).
dotnet_diagnostic.IDE0130.severity = silent
# IDE0200: Remove unnecessary lambda expression (disabled).
dotnet_diagnostic.IDE0200.severity = none
# IDE0290: Use primary constructor (error).
dotnet_diagnostic.IDE0290.severity = error
# IDE0300: Simplify collection creation (suggest).
dotnet_diagnostic.IDE0300.severity = suggestion
# IDE0301: Simplify array creation (suggest).
dotnet_diagnostic.IDE0301.severity = suggestion
# IDE0302: Simplify tuple creation (suggest).
dotnet_diagnostic.IDE0302.severity = suggestion
# IDE0303: Simplify 'new' expression (suggest).
dotnet_diagnostic.IDE0303.severity = suggestion
# IDE0304: Simplify property pattern (suggest).
dotnet_diagnostic.IDE0304.severity = suggestion
# IDE0305: Simplify 'this' and 'base' access (suggest).
dotnet_diagnostic.IDE0305.severity = suggestion
# SA1107 (StyleCop): Code must not contain multiple statements on one line (error).
dotnet_diagnostic.SA1107.severity = error

###############################                 
# VB Coding Conventions       #
###############################
# Apply the following style for Visual Basic files.
[*.vb]
# Preferred order of modifiers in VB declarations (suggested).
visual_basic_preferred_modifier_order = Partial,Default,Private,Protected,Public,Friend,NotOverridable,Overridable,MustOverride,Overloads,Overrides,MustInherit,NotInheritable,Static,Shared,Shadows,ReadOnly,WriteOnly,Dim,Const,WithEvents,Widening,Narrowing,Custom,Async:suggestion